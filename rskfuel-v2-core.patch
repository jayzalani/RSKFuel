+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {IPriceSource} from "../interfaces/IPriceSource.sol";
+
+/// @notice Immutable price, intended ONLY for pegged assets (USDRIF = 1e18).
+/// RISK: if the asset depegs, swaps keep valuing it at the fixed price. The
+/// station's per-swap and daily caps bound the loss; the token can be
+/// disabled with setToken(..., enabled = false).
+contract FixedPriceSource is IPriceSource {
+    uint256 public immutable price;
+
+    constructor(uint256 price_) {
+        require(price_ > 0, "FixedPriceSource: zero price");
+        price = price_;
+    }
+
+    function getPrice() external view returns (uint256, uint256) {
+        return (price, block.timestamp);
+    }
+}
