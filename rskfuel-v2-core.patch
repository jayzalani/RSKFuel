new file mode 100644
index 0000000..8e2d7db
--- /dev/null
+++ b/.env.example
@@ -0,0 +1,32 @@
+# --- secrets (never commit .env) ---
+WALLET_PRIVATE_KEY=
+RSK_TESTNET_RPC_URL=https://public-node.testnet.rsk.co
+
+# --- deploy: tokens (required, must differ) ---
+USDRIF_ADDRESS=
+RIF_ADDRESS=
+# DEPLOY_MOCK_TOKENS=1        # local/testing only: deploys mock USDRIF and RIF
+
+# --- deploy: price sources ---
+# Leave oracle addresses empty to use the bounded manual source (testnet).
+BTC_ORACLE_ADDRESS=
+RIF_ORACLE_ADDRESS=
+USDRIF_ORACLE_ADDRESS=
+INITIAL_BTC_USD=80000          # used only when BTC_ORACLE_ADDRESS is empty
+INITIAL_RIF_USD=0.075          # used only when RIF_ORACLE_ADDRESS is empty
+MANUAL_MAX_STEP_BPS=500
+PRICE_UPDATER_ADDRESS=         # keeper wallet (hot key, step-limited)
+
+# --- deploy: station parameters (USD values are plain dollars) ---
+OWNER_ADDRESS=                 # multisig; defaults to the deployer
+GUARDIAN_ADDRESS=              # can pause only
+GAS_FEE_USD=1.25               # measure first: scripts/measureGas.ts
+MIN_SWAP_USD=5
+MAX_SWAP_USD=10
+USER_DAILY_CAP_USD=10
+DAILY_OUTFLOW_CAP_RBTC=0.002
+RESERVE_FLOOR_RBTC=0.0001
+MAX_PRICE_AGE_SEC=3600
+MAX_DEVIATION_BPS=1000
+SPREAD_BPS=50
+SEED_RBTC=0.002
