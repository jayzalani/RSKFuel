new file mode 100644
index 0000000..b8e5c0b
--- /dev/null
+++ b/scripts/measureGas.ts
@@ -0,0 +1,55 @@
+/**
+ * T2: measure the real gas cost of approve + swap, to size the gas recovery
+ * fee and the sponsor amount.
+ *
+ *   STATION=0x... TOKEN=0x... AMOUNT=5 BTC_USD=80000 \
+ *   npx hardhat run scripts/measureGas.ts --network rskTestnet
+ *
+ * The signer (WALLET_PRIVATE_KEY) needs the token and a little RBTC. The
+ * approve is sent for real; the swap is only estimated unless SEND_SWAP=1.
+ */
+import { ethers } from "hardhat";
+
+const need = (k: string) => { const v = process.env[k]; if (!v) throw new Error(`Missing env var ${k}`); return v; };
+
+async function main() {
+  const [signer] = await ethers.getSigners();
+  const station = await ethers.getContractAt("RBTCGasStation", ethers.getAddress(need("STATION")), signer);
+  const tokenAddr = ethers.getAddress(need("TOKEN"));
+  const token = new ethers.Contract(tokenAddr, [
+    "function approve(address,uint256) returns (bool)", "function allowance(address,address) view returns (uint256)",
+    "function decimals() view returns (uint8)", "function balanceOf(address) view returns (uint256)",
+  ], signer);
+  const dec = Number(await token.decimals());
+  const amount = ethers.parseUnits(process.env.AMOUNT ?? "5", dec);
+  const btcUsd = Number(process.env.BTC_USD ?? "80000");
+  const stationAddr = await station.getAddress();
+
+  const fee = await ethers.provider.getFeeData();
+  const gasPrice = fee.gasPrice ?? 0n;
+  console.log(`Signer ${signer.address}  gasPrice ${gasPrice} wei`);
+
+  const [q, status] = await station.previewSwap(tokenAddr, amount, signer.address);
+  console.log(`previewSwap status=${status} (0 = OK) netRBTC=${ethers.formatEther(q.netRBTC)}`);
+
+  const approveGas = await token.approve.estimateGas(stationAddr, amount);
+  if ((await token.allowance(signer.address, stationAddr)) < amount) {
+    console.log("Sending approve (real tx)...");
+    await (await token.approve(stationAddr, amount)).wait();
+  }
+  const swapGas = await station.swap.estimateGas(tokenAddr, amount, 0, Math.floor(Date.now() / 1000) + 3600);
+  if (process.env.SEND_SWAP === "1") {
+    const rc = await (await station.swap(tokenAddr, amount, 0, Math.floor(Date.now() / 1000) + 3600)).wait();
+    console.log(`Actual swap gasUsed=${rc!.gasUsed}`);
+  }
+
+  const usd = (wei: bigint) => (Number(ethers.formatEther(wei)) * btcUsd).toFixed(4);
+  const aCost = approveGas * gasPrice, sCost = swapGas * gasPrice, total = aCost + sCost;
+  console.log(`\napprove gas ${approveGas}  -> ${ethers.formatEther(aCost)} RBTC (~$${usd(aCost)})`);
+  console.log(`swap    gas ${swapGas}  -> ${ethers.formatEther(sCost)} RBTC (~$${usd(sCost)})`);
+  console.log(`TOTAL   ${ethers.formatEther(total)} RBTC (~$${usd(total)}) at BTC=$${btcUsd}`);
+  console.log(`\nSuggested starting points (my rule of thumb, adjust):`);
+  console.log(`  GAS_FEE_USD       ~ ${(Number(usd(total)) * 1.2).toFixed(2)}   (1.2x real cost)`);
+  console.log(`  sponsor amount    ~ ${ethers.formatEther((total * 3n) / 2n)} RBTC   (1.5x real cost)`);
+}
+main().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); });
