@@ -0,0 +1,60 @@
+/**
+ * T1: read-only checks of the real tokens and oracles you plan to use.
+ *
+ *   INSPECT_TOKENS=0xTokenA,0xTokenB INSPECT_ORACLES=0xOracle1,0xOracle2 \
+ *   npx hardhat run scripts/inspectOnchain.ts --network rskTestnet
+ *
+ * Get oracle addresses from Money On Chain's official docs (do not guess).
+ * Nothing is sent on-chain.
+ */
+import { ethers } from "hardhat";
+
+const list = (k: string) => (process.env[k] ?? "").split(",").map((s) => s.trim()).filter(Boolean);
+const tryCall = async <T>(f: () => Promise<T>): Promise<T | undefined> => { try { return await f(); } catch { return undefined; } };
+
+async function inspectToken(a: string) {
+  const p = ethers.provider;
+  const code = await p.getCode(a);
+  console.log(`\nTOKEN ${a}`);
+  if (code === "0x") return console.log("  NO CONTRACT CODE on this network");
+  const c = new ethers.Contract(a, [
+    "function name() view returns (string)", "function symbol() view returns (string)",
+    "function decimals() view returns (uint8)", "function totalSupply() view returns (uint256)",
+    "function DOMAIN_SEPARATOR() view returns (bytes32)", "function nonces(address) view returns (uint256)",
+  ], p);
+  const [name, symbol, decimals, supply] = await Promise.all([
+    tryCall(() => c.name()), tryCall(() => c.symbol()), tryCall(() => c.decimals()), tryCall(() => c.totalSupply()),
+  ]);
+  console.log(`  name=${name} symbol=${symbol} decimals=${decimals} totalSupply=${supply?.toString()}`);
+  const ds = await tryCall(() => c.DOMAIN_SEPARATOR());
+  const nonce = await tryCall(() => c.nonces(ethers.ZeroAddress));
+  console.log(`  permit (EIP-2612) likely: ${ds !== undefined && nonce !== undefined}`);
+  console.log(`  ERC-677 transferAndCall selector in code: ${code.toLowerCase().includes("4000aea0")}`);
+  const impl = await p.getStorage(a, "0x360894a13ba1a3210667c828492db98dca3e2076cc3735a920a3ca505d382bbc");
+  console.log(`  EIP-1967 proxy: ${BigInt(impl) !== 0n ? "yes, implementation " + ethers.getAddress("0x" + impl.slice(26)) : "no"}`);
+}
+
+async function inspectOracle(a: string) {
+  const p = ethers.provider;
+  console.log(`\nORACLE ${a}`);
+  if ((await p.getCode(a)) === "0x") return console.log("  NO CONTRACT CODE on this network");
+  const moc = new ethers.Contract(a, ["function peek() view returns (bytes32,bool)"], p);
+  const r = await tryCall(() => moc.peek());
+  if (r) {
+    const raw = BigInt(r[0]);
+    console.log(`  peek(): raw=${raw} valid=${r[1]}  as 1e18-scaled USD = ${ethers.formatEther(raw)}`);
+    console.log("  CHECK: this must look like a USD price per 1 whole asset (e.g. ~80000 for BTC).");
+  } else console.log("  peek() not available");
+  const cl = new ethers.Contract(a, ["function latestAnswer() view returns (int256)", "function decimals() view returns (uint8)"], p);
+  const ans = await tryCall(() => cl.latestAnswer());
+  if (ans !== undefined) console.log(`  latestAnswer()=${ans} decimals=${await tryCall(() => cl.decimals())} (Chainlink-style; needs its own adapter)`);
+}
+
+async function main() {
+  const net = await ethers.provider.getNetwork();
+  console.log(`Chain ${net.chainId}, block ${await ethers.provider.getBlockNumber()}`);
