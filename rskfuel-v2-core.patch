@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {Ownable} from "@openzeppelin/contracts/access/Ownable.sol";
+import {Ownable2Step} from "@openzeppelin/contracts/access/Ownable2Step.sol";
+import {IPriceSource} from "../interfaces/IPriceSource.sol";
+
+/// @notice Timestamped, step-limited manual price for testnet or for assets
+/// with no on-chain feed yet. The `updater` (a hot keeper key) can only move
+/// the price by `maxStepBps` per update, so a stolen updater key cannot set
+/// an arbitrary price. The owner (multisig) is not step-limited.
+contract BoundedManualPriceSource is IPriceSource, Ownable2Step {
+    uint256 public price;
+    uint256 public updatedAt;
+    uint256 public maxStepBps;
+    address public updater;
+
+    event PriceSet(uint256 oldPrice, uint256 newPrice, address indexed by);
+    event UpdaterSet(address indexed updater);
+    event MaxStepSet(uint256 bps);
+
+    constructor(address owner_, uint256 initialPrice, uint256 maxStepBps_) Ownable(owner_) {
+        require(initialPrice > 0, "ManualSource: zero price");
+        require(maxStepBps_ > 0 && maxStepBps_ <= 10_000, "ManualSource: bad step");
+        price = initialPrice;
+        updatedAt = block.timestamp;
+        maxStepBps = maxStepBps_;
+    }
+
+    function getPrice() external view returns (uint256, uint256) {
+        return (price, updatedAt);
+    }
+
+    function setPrice(uint256 newPrice) external {
+        require(msg.sender == owner() || msg.sender == updater, "ManualSource: not authorized");
+        require(newPrice > 0, "ManualSource: zero price");
+        if (msg.sender != owner()) {
+            uint256 diff = newPrice > price ? newPrice - price : price - newPrice;
+            require((diff * 10_000) / price <= maxStepBps, "ManualSource: step too large");
+        }
+        emit PriceSet(price, newPrice, msg.sender);
+        price = newPrice;
+        updatedAt = block.timestamp;
+    }
+
+    function setUpdater(address updater_) external onlyOwner {
+        updater = updater_;
+        emit UpdaterSet(updater_);
+    }
+
+    function setMaxStepBps(uint256 bps) external onlyOwner {
+        require(bps > 0 && bps <= 10_000, "ManualSource: bad step");
+        maxStepBps = bps;
+        emit MaxStepSet(bps);
+    }
+}
