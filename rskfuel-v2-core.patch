+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import "@openzeppelin/contracts/token/ERC20/IERC20.sol";
+
+interface IStation {
+    function swap(address token, uint256 amountIn, uint256 minRBTCOut, uint256 deadline) external;
+}
+
+/// @dev Test double: tries to re-enter swap() from its receive() hook.
+contract ReentrantReceiver {
+    IStation public station;
+    address public token;
+    uint256 public amount;
+    bool public reentered;
+
+    constructor(address station_, address token_) {
+        station = IStation(station_);
+        token = token_;
+    }
+
+    function attack(uint256 amount_) external {
+        amount = amount_;
+        IERC20(token).approve(address(station), type(uint256).max);
+        station.swap(token, amount_, 0, block.timestamp + 1 hours);
+    }
+
+    receive() external payable {
+        reentered = true;
+        station.swap(token, amount, 0, block.timestamp + 1 hours);
+    }
+}
