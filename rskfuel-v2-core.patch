@@ -0,0 +1,11 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+/// @notice One price feed for ONE asset, always expressed in USD.
+/// The gas station only ever talks to this interface, so a new coin or a new
+/// chain is a new adapter, never a change to the swap logic.
+interface IPriceSource {
+    /// @return priceUsd USD value of ONE whole unit of the asset, scaled by 1e18
+    /// @return updatedAt Unix time the price was last updated
+    function getPrice() external view returns (uint256 priceUsd, uint256 updatedAt);
+}
