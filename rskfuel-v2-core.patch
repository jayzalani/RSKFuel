diff --git a/scripts/deploy.ts b/scripts/deploy.ts
new file mode 100644
index 0000000..8a7a07e
--- /dev/null
+++ b/scripts/deploy.ts
@@ -0,0 +1,170 @@
+/**
+ * Deploys RBTCGasStation v2 and its price sources.
+ *
+ *   npx hardhat run scripts/deploy.ts --network rskTestnet
+ *
+ * Config is read from the environment (see .env.example). Nothing is guessed:
+ * token addresses are required and must be different from each other.
+ */
+import { ethers, network } from "hardhat";
+import * as fs from "fs";
+import * as path from "path";
+
+const env = (k: string, d?: string) => process.env[k] ?? d;
+const need = (k: string) => {
+  const v = process.env[k];
+  if (!v) throw new Error(`Missing env var ${k}`);
+  return v;
+};
+const addr = (k: string, v: string) => {
+  if (!ethers.isAddress(v)) throw new Error(`${k} is not a valid address: ${v}`);
+  return ethers.getAddress(v);
+};
+
+async function main() {
+  const [deployer] = await ethers.getSigners();
+  const provider = ethers.provider;
+  console.log(`Network: ${network.name}  Deployer: ${deployer.address}`);
+  console.log(`Balance: ${ethers.formatEther(await provider.getBalance(deployer.address))} RBTC`);
+
+  const finalOwner = addr("OWNER_ADDRESS", env("OWNER_ADDRESS", deployer.address)!);
+
+  // ---- tokens -------------------------------------------------------------
+  let usdrif: string;
+  let rif: string;
+  if (env("DEPLOY_MOCK_TOKENS") === "1") {
+    const Token = await ethers.getContractFactory("MockERC20");
+    const u = await Token.deploy("USDRIF", "USDRIF", 18);
+    const r = await Token.deploy("RIF", "RIF", 18);
+    await Promise.all([u.waitForDeployment(), r.waitForDeployment()]);
+    await (await u.mint(deployer.address, ethers.parseEther("1000"))).wait();
+    await (await r.mint(deployer.address, ethers.parseEther("100000"))).wait();
+    usdrif = await u.getAddress();
+    rif = await r.getAddress();
+    console.log("Mock tokens deployed (testing only):", usdrif, rif);
+  } else {
+    usdrif = addr("USDRIF_ADDRESS", need("USDRIF_ADDRESS"));
+    rif = addr("RIF_ADDRESS", need("RIF_ADDRESS"));
+  }
+  if (usdrif.toLowerCase() === rif.toLowerCase()) throw new Error("USDRIF and RIF addresses must be different");
+  for (const [name, a] of [["USDRIF", usdrif], ["RIF", rif]]) {
+    if ((await provider.getCode(a)) === "0x") throw new Error(`${name} has no contract code at ${a} on ${network.name}`);
+  }
+
+  // ---- price sources ------------------------------------------------------
+  const MANUAL_STEP_BPS = Number(env("MANUAL_MAX_STEP_BPS", "500"));
+  const btcOracle = env("BTC_ORACLE_ADDRESS");
+  const rifOracle = env("RIF_ORACLE_ADDRESS");
+  const usdrifOracle = env("USDRIF_ORACLE_ADDRESS");
+
+  const deployMoc = async (a: string) => {
+    const f = await ethers.getContractFactory("MoCPriceSource");
+    const c = await f.deploy(addr("oracle", a));
+    await c.waitForDeployment();
+    return c.getAddress();
+  };
+  const deployManual = async (label: string, initialUsd: string) => {
+    const f = await ethers.getContractFactory("BoundedManualPriceSource");
+    const c = await f.deploy(deployer.address, ethers.parseEther(initialUsd), MANUAL_STEP_BPS);
+    await c.waitForDeployment();
+    const updater = env("PRICE_UPDATER_ADDRESS");
+    if (updater) await (await c.setUpdater(addr("PRICE_UPDATER_ADDRESS", updater))).wait();
+    console.log(`${label}: manual source (initial $${initialUsd})`);
+    return c;
+  };
+
+  const manualSources: string[] = [];
+  let btcSource: string;
+  if (btcOracle) btcSource = await deployMoc(btcOracle);
+  else {
+    const c = await deployManual("BTC/USD", need("INITIAL_BTC_USD"));
+    btcSource = await c.getAddress();
+    manualSources.push(btcSource);
+  }
+  let rifSource: string;
+  if (rifOracle) rifSource = await deployMoc(rifOracle);
+  else {
+    const c = await deployManual("RIF/USD", need("INITIAL_RIF_USD"));
+    rifSource = await c.getAddress();
+    manualSources.push(rifSource);
+  }
+  let usdrifSource: string;
+  if (usdrifOracle) usdrifSource = await deployMoc(usdrifOracle);
+  else {
+    const f = await ethers.getContractFactory("FixedPriceSource");
+    const c = await f.deploy(ethers.parseEther("1"));
+    await c.waitForDeployment();
+    usdrifSource = await c.getAddress();
+    console.log("USDRIF: fixed $1 peg source (documented risk: no depeg protection beyond caps)");
+  }
+
+  // ---- station ------------------------------------------------------------
+  const params = {
+    btcPriceSource: btcSource,
+    gasRecoveryFeeUsd: ethers.parseEther(env("GAS_FEE_USD", "1.25")!),
+    minSwapUsd: ethers.parseEther(env("MIN_SWAP_USD", "5")!),
+    maxSwapUsd: ethers.parseEther(env("MAX_SWAP_USD", "10")!),
+    userDailyCapUsd: ethers.parseEther(env("USER_DAILY_CAP_USD", "10")!),
+    dailyOutflowCapWei: ethers.parseEther(env("DAILY_OUTFLOW_CAP_RBTC", "0.002")!),
+    reserveFloorWei: ethers.parseEther(env("RESERVE_FLOOR_RBTC", "0.0001")!),
+    maxPriceAge: Number(env("MAX_PRICE_AGE_SEC", "3600")),
+    maxDeviationBps: Number(env("MAX_DEVIATION_BPS", "1000")),
+  };
+  const spreadBps = Number(env("SPREAD_BPS", "50"));
+
+  const Station = await ethers.getContractFactory("RBTCGasStation");
+  const station = await Station.deploy(deployer.address, params);
+  await station.waitForDeployment();
+  const stationAddr = await station.getAddress();
+  console.log("RBTCGasStation:", stationAddr);
+
+  await (await station.setToken(usdrif, usdrifSource, spreadBps, true)).wait();
+  await (await station.setToken(rif, rifSource, spreadBps, true)).wait();
+  const guardian = env("GUARDIAN_ADDRESS");
+  if (guardian) await (await station.setGuardian(addr("GUARDIAN_ADDRESS", guardian))).wait();
+
+  const seed = ethers.parseEther(env("SEED_RBTC", "0.002")!);
+  if (seed > 0n) await (await deployer.sendTransaction({ to: stationAddr, value: seed })).wait();
+  await (await station.checkpointPrices()).wait();
+  console.log(`Reserve funded with ${ethers.formatEther(seed)} RBTC; price baseline checkpointed`);
+
+  // ---- hand over ownership (two-step: the new owner must accept) -----------
+  const pending: string[] = [];
+  if (finalOwner.toLowerCase() !== deployer.address.toLowerCase()) {
+    await (await station.transferOwnership(finalOwner)).wait();
+    pending.push(stationAddr);
+    for (const s of manualSources) {
+      const c = await ethers.getContractAt("BoundedManualPriceSource", s);
+      await (await c.transferOwnership(finalOwner)).wait();
+      pending.push(s);
+    }
+  }
+
+  // ---- save ---------------------------------------------------------------
+  const dir = path.join(__dirname, "..", "deployments");
+  fs.mkdirSync(dir, { recursive: true });
+  const out = {
+    network: network.name,
+    chainId: Number((await provider.getNetwork()).chainId),
+    deployedAt: new Date().toISOString(),
+    blockNumber: await provider.getBlockNumber(),
+    station: stationAddr,
+    tokens: { usdrif, rif },
+    priceSources: { btc: btcSource, rif: rifSource, usdrif: usdrifSource },
+    owner: finalOwner,
+    ownerMustAccept: pending,
+    params: Object.fromEntries(Object.entries(params).map(([k, v]) => [k, v.toString()])),
+    spreadBps,
+  };
+  fs.writeFileSync(path.join(dir, `${network.name}.json`), JSON.stringify(out, null, 2));
+  const stationArgs = [deployer.address, Object.values(params).map((v) => v.toString())]; // station is constructed with the deployer as owner
+  fs.writeFileSync(
+    path.join(dir, `${network.name}.station-args.js`),
+    `module.exports = ${JSON.stringify(stationArgs, null, 2)};\n`
+  );
+  console.log(`Saved deployments/${network.name}.json`);
+  console.log(`Verify:  npx hardhat verify --network ${network.name} --constructor-args deployments/${network.name}.station-args.js ${stationAddr}`);
+  if (pending.length) console.log(`OWNER ${finalOwner} must call acceptOwnership() on:\n  ${pending.join("\n  ")}`);
+}
+
+main().then(() => process.exit(0)).catch((e) => { console.error(e); process.exit(1); });
