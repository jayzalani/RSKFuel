@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: MIT
+pragma solidity ^0.8.20;
+
+import {IPriceSource} from "../interfaces/IPriceSource.sol";
+import {IMoCBaseOracle} from "../interfaces/IMoCBaseOracle.sol";
+
+/// @notice Adapter: Money On Chain style oracle -> IPriceSource.
+/// `peek()` carries no timestamp, so freshness is the oracle's own `valid`
+/// flag. We report block.timestamp as updatedAt and revert when invalid.
+contract MoCPriceSource is IPriceSource {
+    IMoCBaseOracle public immutable oracle;
+
+    constructor(address oracle_) {
+        require(oracle_ != address(0), "MoCPriceSource: zero oracle");
+        oracle = IMoCBaseOracle(oracle_);
+    }
+
+    function getPrice() external view returns (uint256 priceUsd, uint256 updatedAt) {
+        (bytes32 raw, bool valid) = oracle.peek();
+        require(valid, "MoCPriceSource: oracle invalid");
+        priceUsd = uint256(raw);
+        require(priceUsd > 0, "MoCPriceSource: zero price");
+        updatedAt = block.timestamp;
+    }
+}
